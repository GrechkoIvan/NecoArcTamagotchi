<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/scroll_button_pressed_background_color" />
            <stroke
                android:width="4dp"
                android:color="@color/scroll_button_pressed_border_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/scroll_button_default_background_color" />
            <stroke
                android:width="4dp"
                android:color="@color/scroll_button_default_border_color" />
        </shape>
    </item>
</selector>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_primary" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2dp"
                android:color="@color/panel_border_color" />
        </shape>
    </item>
    <item android:top="5dp" android:bottom="5dp" android:end="5dp" android:start="5dp">
        <shape android:shape="rectangle" >
            <solid android:color="@color/settings_panel_color" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>



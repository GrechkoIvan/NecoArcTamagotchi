<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/feed_button_pressed_background_color"/>
            <corners android:radius="16dp"/>
            <stroke android:width="4dp" android:color="@color/feed_button_pressed_border_color"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/feed_button_default_background_color"/>
            <corners android:radius="16dp"/>
            <stroke android:width="4dp" android:color="@color/feed_button_default_border_color"/>
        </shape>
    </item>
</selector>

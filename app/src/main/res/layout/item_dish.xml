<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/plate_image"
        android:layout_width="270dp"
        android:layout_height="100dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/sprite_plate"/>

    <ImageView
        android:id="@+id/dish_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintRight_toRightOf="@id/plate_image"
        app:layout_constraintBottom_toBottomOf="@id/plate_image"
        android:layout_margin="5dp"
        android:background="@drawable/bg_cost_panel"

        android:gravity="end" >

        <TextView
            android:id="@+id/dish_cost_text"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:paddingHorizontal="5dp"
            android:gravity="center_vertical|end"
            android:layout_gravity="center_vertical"
            android:textColor="@color/action_button_text_color"
            android:textStyle="bold"
            android:textSize="18sp" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:src="@drawable/sprite_coin"
            android:contentDescription="@string/coin_desc" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>